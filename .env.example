# Environment mode
NODE_ENV=development
PORT=5000

# Database
# For local Docker: postgresql://postgres:postgrespassword@localhost:5432/deutschwelt?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/deutschwelt?schema=public"

# Legacy MySQL connector is disabled by default; enable only with dedicated DB_* values.
ENABLE_MYSQL=false

# Authentication & Sessions
SESSION_SECRET="super-secret-session-key-must-be-at-least-32-chars-long"
COOKIE_SECRET="super-secret-cookie-key-must-be-at-least-32-chars-long"
SESSION_MAX_AGE_DAYS=14

# CORS & Frontend URL
FRONTEND_URL="http://localhost:5173"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Optional local sandbox login passwords. If left blank, sandbox accounts get random,
# non-recoverable passwords at process start and cannot be logged into by default.
SANDBOX_ADMIN_PASSWORD=""
SANDBOX_TEACHER_PASSWORD=""
SANDBOX_STUDENT_PASSWORD=""

# Google Drive file storage (connect the academy Google account from Admin > Settings)
# Create an OAuth Web application client. Register:
#   http://localhost:5173/api/v1/admin/drive/callback
# as an authorized redirect URI, and your site origin as an authorized JavaScript origin.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
# Enable Google Picker API and create a browser-restricted API key.
# Website restrictions should include your app origin and https://docs.google.com/*.
# API restrictions should include Google Picker API and Google Drive API.
GOOGLE_DRIVE_PICKER_API_KEY=""
# Google Cloud project number (not the project ID).
GOOGLE_DRIVE_PROJECT_NUMBER=""

# Optional development sample-seed accounts. The sample seed is blocked in production.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_EMAIL=""
SEED_TEACHER_PASSWORD=""
SEED_STUDENT_EMAIL=""
SEED_STUDENT_PASSWORD=""

# One-time production administrator bootstrap. Remove these after running db:create-admin.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_FIRST_NAME=""
BOOTSTRAP_ADMIN_LAST_NAME=""
