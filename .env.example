# Environment mode
NODE_ENV=development
PORT=5000

# Database
# For local Docker: postgresql://postgres:postgrespassword@localhost:5432/deutschwelt?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/deutschwelt?schema=public"

# Authentication & Sessions
SESSION_SECRET="super-secret-session-key-must-be-at-least-32-chars-long"
COOKIE_SECRET="super-secret-cookie-key-must-be-at-least-32-chars-long"
SESSION_MAX_AGE_DAYS=14

# CORS & Frontend URL
FRONTEND_URL="http://localhost:5173"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Development Seed Credentials (DO NOT USE IN PRODUCTION)
SEED_ADMIN_EMAIL="admin@deutschwelt.de"
SEED_ADMIN_PASSWORD="AdminDeutschWelt2026!"
SEED_TEACHER_EMAIL="teacher@deutschwelt.de"
SEED_TEACHER_PASSWORD="TeacherDeutschWelt2026!"
SEED_STUDENT_EMAIL="student@deutschwelt.de"
SEED_STUDENT_PASSWORD="StudentDeutschWelt2026!"
