{
  "name": "deutschwelt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeutschWelt - Complete German Learning & Coaching Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run --workspace=@deutschwelt/web dev",
    "dev:api": "npm run --workspace=@deutschwelt/api dev",
    "build": "node scripts/build-vercel.js",
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma || npx --yes prisma generate --schema apps/api/prisma/schema.prisma || true",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm run --workspace=@deutschwelt/api db:generate",
    "db:migrate": "npm run --workspace=@deutschwelt/api db:migrate",
    "db:push": "prisma db push --schema apps/api/prisma/schema.prisma",
    "db:seed": "npm run --workspace=@deutschwelt/api db:seed",
    "db:studio": "npm run --workspace=@deutschwelt/api db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^189.0.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "prisma": "^6.4.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
